generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            UserRole         @default(USER)
  morattaProfile  MorattaProfile?
  morattaProjects MorattaProject[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model SystemSettings {
  id        String   @id @default("singleton")
  aiProvider String  @default("gemini") // "gemini" | "groq"
  updatedAt DateTime @updatedAt
}

enum MorattaProfileType {
  PERSONAL
  PROFESSIONAL
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  ERROR
}

model MorattaProfile {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  type      MorattaProfileType @default(PERSONAL)
  clients   MorattaClient[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model MorattaClient {
  id        String           @id @default(uuid())
  profileId String
  profile   MorattaProfile   @relation(fields: [profileId], references: [id])
  name      String
  email     String?
  phone     String?
  projects  MorattaProject[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([profileId])
}

model MorattaProject {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  clientId        String?
  client          MorattaClient?     @relation(fields: [clientId], references: [id])
  name            String
  status          ProjectStatus      @default(DRAFT)
  params          Json
  variations      MorattaVariation[]
  activeVariation String?
  shareToken      String?            @unique
  shareEnabled    Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([shareToken])
}

model MorattaVariation {
  id          String         @id @default(uuid())
  projectId   String
  project     MorattaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  floorPlan   Json
  estimate    Json?
  threeDModel Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}
